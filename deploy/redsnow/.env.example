# RED-SNOW two-Spark launcher settings. Copy to deploy/redsnow/.env (ignored by git) and fill in the <...> values.
# start.sh, stop.sh and docker/*.sh read it; a variable set in the environment wins over this file.
# Every other setting (CONTEXT, PARALLEL, KV_DTYPE, ...) can go here too: see the settings table in README.md.

# ---- required: the two nodes ------------------------------------------------------------------------------------
# Rank 0 (the head, where you run the scripts) and rank 1 (the worker), by their addresses on the QSFP/RoCE link.
HEAD_ADDR="<rank0-roce-ip>"
WORKER_ADDR="<rank1-roce-ip>"
# How the head reaches the worker over ssh without a password (user@host; any interface works).
WORKER_SSH="<worker-ssh>"

# ---- RoCE devices (DGX Spark defaults; check with `ibdev2netdev` and `show_gids` on each node) ---------------------
# IFACE=enp1s0f0np0          # NCCL_SOCKET_IFNAME, the netdev that holds HEAD_ADDR / WORKER_ADDR
# HCA=rocep1s0f0             # NCCL_IB_HCA, the RDMA device of that netdev
# HEAD_GID=3                 # GID index of HEAD_ADDR's RoCE v2 entry on the head (default: found in sysfs)
# WORKER_GID=3               # the same on the worker (default: found in sysfs)

# ---- model folders (absolute paths; the same drafter path on both nodes) ----------------------------------------
# MODEL_RANK0=/var/tmp/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-4.91bpw   # the full pack, on the head
# MODEL_RANK1=/var/tmp/models/redsnow-rank1                          # the pre-split rank-1 folder, on the worker
# DRAFTER=/var/tmp/models/GLM-5.3-Flash-DFlash2                      # on both nodes; "none": MTP drafts

# ---- container mode (docker/start-docker.sh) ----------------------------------------------------------------------
# IMAGE=redsnow-tensorfold:<tag>     # default: the tag build.sh gives the current commit
# BRANCH=HEAD                        # the commit build.sh builds by default

# ---- serving -------------------------------------------------------------------------------------------------------
# SERVED_NAME=RED-SNOW-5.3-FLASH
# PORT=8000
# CONTEXT=327680
# MEMORY_RESERVE_GIB=14.5
